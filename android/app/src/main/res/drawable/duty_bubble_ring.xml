<?xml version="1.0" encoding="utf-8"?>
<!--
  The disc the logo sits on. Opaque and outlined, because the bubble floats over
  an arbitrary app — a transparent badge over a white map or a dark video is
  legible in one case and invisible in the other.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#ffffff" />
    <stroke android:width="1dp" android:color="#e0e0e0" />
</shape>
