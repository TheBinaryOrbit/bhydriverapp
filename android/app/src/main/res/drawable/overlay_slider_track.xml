<?xml version="1.0" encoding="utf-8"?>
<!--
  The bid slider's track, as `FareSlider` draws it in the app: an 8dp grey rail
  with the navy fill running up to the thumb. `SeekBar` wants both in one
  layer-list keyed by the framework's own ids, which is the whole reason this
  file exists rather than a pair of shapes.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#e0e0e0" />
            <corners android:radius="4dp" />
            <size android:height="8dp" />
        </shape>
    </item>

    <!-- Clipped, not scaled: the fill has to keep its rounded left end while its
         right end tracks the value. -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#002d4b" />
                <corners android:radius="4dp" />
                <size android:height="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
